          "exercises": [
            {
              "id": "a1.u1.l1.e1",
              "type": "multiple_choice",
              "prompt": "¿Qué significa este signo?",
              "signId": "HOLA",
              "options": ["Hola", "Adiós", "Buenas tardes", "Buenos días"],
              "answer": "Hola"
            },
            {
              "id": "a1.u1.l1.e2",
              "type": "multiple_choice",
              "prompt": "¿Qué significa este signo?",
              "signId": "ADIOS",
              "options": ["Hola", "Adiós", "Perdón", "Gracias"],
              "answer": "Adiós"
            },
            {
              "id": "a1.u1.l1.e3",
              "type": "multiple_choice",
              "prompt": "Es de mañana. ¿Cómo saludas?",
              "signId": "BUENOS_DIAS",
              "options": ["Buenos días", "Buenas tardes", "Buenas noches", "Hola"],
              "answer": "Buenos días"
            },
            {
              "id": "a1.u1.l1.e4",
              "type": "type_word",
              "prompt": "Escribe la traducción de este signo.",
              "signId": "BUENAS_TARDES",
              "acceptable": ["buenas tardes", "buenas tardes."]
            },
            {
              "id": "a1.u1.l1.e5",
              "type": "match_pairs",
              "prompt": "Empareja cada signo con su traducción.",
              "pairs": [
                { "signId": "HOLA", "translation": "Hola" },
                { "signId": "ADIOS", "translation": "Adiós" },
                { "signId": "BUENOS_DIAS", "translation": "Buenos días" },
                { "signId": "BUENAS_NOCHES", "translation": "Buenas noches" }
              ]
            }
          ]
        },
