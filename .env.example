# Supabase — obtenidos desde https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (nunca expongas en cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (usada por el callback OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demo local (sin Supabase). Cuando está a "1", la app persiste todo el
# progreso en localStorage y salta la comprobación de auth del middleware.
# Útil para pruebas y para lanzar la app sin credenciales.
NEXT_PUBLIC_DEMO_MODE=
