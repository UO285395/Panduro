{
  "id": "A1",
  "title": "LSE A1 · Contacto inicial",
  "signs": [
    {
      "id": "HOLA",
      "gloss": "HOLA",
      "translation": "Hola",
      "description": "Mano dominante abierta, palma hacia delante a la altura de la sien; movimiento breve de saludo.",
      "handedness": "one",
      "tags": ["saludo", "u1"]
    },
    {
      "id": "ADIOS",
      "gloss": "ADIÓS",
      "translation": "Adiós",
      "description": "Mano abierta, palma hacia delante, se agita ligeramente como despedida.",
      "handedness": "one",
      "tags": ["saludo", "u1"]
    },
    {
      "id": "BUENOS_DIAS",
      "gloss": "BUENOS-DÍAS",
      "translation": "Buenos días",
      "description": "Signo compuesto: BIEN (pulgar arriba) + DÍA (mano curva describiendo el arco solar).",
      "handedness": "one",
      "tags": ["saludo", "u1"]
    },
    {
      "id": "BUENAS_TARDES",
      "gloss": "BUENAS-TARDES",
      "translation": "Buenas tardes",
      "description": "Signo compuesto: BIEN + TARDE (mano baja hacia el horizonte).",
      "handedness": "one",
      "tags": ["saludo", "u1"]
    },
    {
      "id": "BUENAS_NOCHES",
      "gloss": "BUENAS-NOCHES",
      "translation": "Buenas noches",
      "description": "Signo compuesto: BIEN + NOCHE (mano describe curva descendente).",
      "handedness": "one",
      "tags": ["saludo", "u1"]
    },
    {
      "id": "GRACIAS",
      "gloss": "GRACIAS",
      "translation": "Gracias",
      "description": "Yemas de los dedos tocan la barbilla y se proyectan hacia delante.",
      "handedness": "one",
      "tags": ["cortesia", "u1"]
    },
    {
      "id": "POR_FAVOR",
      "gloss": "POR-FAVOR",
      "translation": "Por favor",
      "description": "Mano plana sobre el pecho con un movimiento circular corto.",
      "handedness": "one",
      "tags": ["cortesia", "u1"]
    },
    {
      "id": "PERDON",
      "gloss": "PERDÓN",
      "translation": "Perdón",
      "description": "Puño con pulgar extendido roza el pecho en un círculo pequeño.",
      "handedness": "one",
      "tags": ["cortesia", "u1"]
    },
    {
      "id": "SI",
      "gloss": "SÍ",
      "translation": "Sí",
      "description": "Puño cerrado que asiente con el nudillo del índice arriba y abajo.",
