      "tags": ["respuesta", "u1"]
    },
    {
      "id": "NO",
      "gloss": "NO",
      "translation": "No",
      "description": "Índice extendido que oscila lateralmente.",
      "handedness": "one",
      "tags": ["respuesta", "u1"]
    },
    {
      "id": "YO",
      "gloss": "YO",
      "translation": "Yo",
      "description": "Índice extendido señalando el propio pecho.",
      "handedness": "one",
      "tags": ["pronombre", "u1"]
    },
    {
      "id": "TU",
      "gloss": "TÚ",
      "translation": "Tú",
      "description": "Índice extendido señalando a la persona interlocutora.",
      "handedness": "one",
      "tags": ["pronombre", "u1"]
    },
    {
      "id": "NOMBRE",
      "gloss": "NOMBRE",
      "translation": "Nombre / Me llamo",
      "description": "Índice y medio extendidos golpean dos veces sobre la palma opuesta.",
      "handedness": "two",
      "tags": ["presentacion", "u1"]
    },
    {
      "id": "BIEN",
      "gloss": "BIEN",
      "translation": "Bien",
      "description": "Pulgar hacia arriba con puño cerrado.",
      "handedness": "one",
      "tags": ["estado", "u1"]
    },
    {
      "id": "MAL",
      "gloss": "MAL",
      "translation": "Mal",
      "description": "Pulgar hacia abajo con puño cerrado.",
      "handedness": "one",
      "tags": ["estado", "u1"]
    },
    {
      "id": "COMO_ESTAS",
      "gloss": "CÓMO-ESTAR",
      "translation": "¿Cómo estás?",
